section.work-single-performed(data-work-performed)
	.work-single-performed__container._container
		.work-single-performed__top
			figure.work-single-performed__main-media
				img.work-single-performed__main-image(
					src="images/asfsafsafsafssa.png"
					alt="Санузел после ремонта"
					title="Санузел после ремонта"
					width="760"
					height="620"
					loading="lazy"
				)

			.work-single-performed__content
				h2.section__title.work-single-performed__title Какие работы были выполнены
				p.section__subtitle.work-single-performed__text
					| Ремонт квартиры начался с демонтажа: вынесли все лишнее, зачистили стены и организовали вывоз мусора контейнерами.
					| Важно было сразу подготовить проемы лоджий под объединение с кухней и спальней, не нарушая при этом тепловой режим
					| остальной квартиры. Все процессы шли по графику, с соблюдением технологических пауз на просушку стяжки и штукатурных
					| слоев, чтобы исключить трещины на финише.
				p.work-single-performed__text.work-single-performed__text--strong
					| После завершения черновых этапов ремонта и разводки коммуникаций началась самая тонкая часть — отделка.
					| Стены в квартире выводили в идеал, так как малярные работы не прощают малейших неровностей.
					| Особого внимания потребовала стыковка микроцемента в санузлах и монтаж скрытых дверей,
					| которые должны стоять в одной плоскости со стеной.

		.work-single-performed__middle
			.work-single-performed__list
				h3.work-single-performed__list-title В ходе ремонта в квартире были проведены следующие работы:
				ol.work-single-performed__items
					li.work-single-performed__item тотальный демонтаж всех перегородок и покрытий от застройщика;
					li.work-single-performed__item монтаж теплого контура на лоджиях для расширения комнат;
					li.work-single-performed__item полная замена штатной электрики на новую медную проводку;
					li.work-single-performed__item установка современных узлов водоснабжения с коллекторной разводкой;
					li.work-single-performed__item выравнивание стен штукатуркой по маякам строго под покраску;
					li.work-single-performed__item монтаж скрытых коробов и полотен дверей формата invisible;
					li.work-single-performed__item подготовка основания и укладка ламината единым полотном;
					li.work-single-performed__item сборка декоративных 3D-панелей и поклейка настенных молдингов;
					li.work-single-performed__item отделка стен и полов в санузлах бесшовным микроцементом;
					li.work-single-performed__item растяжка натяжных потолков с установкой встроенных светильников.

			figure.work-single-performed__secondary-media
				img.work-single-performed__secondary-image(
					src="images/ssdgdsgssdgsdsdsd.png"
					alt="Кухня-гостиная после ремонта"
					title="Кухня-гостиная после ремонта"
