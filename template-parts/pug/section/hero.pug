//- HERO
section.hero
  .hero__container._container
    .hero__grid
    
      .hero__content
        p.hero__subtitle Ремонт квартир под ключ в Москве и МО
        h2.hero__title РЕМОНТ КВАРТИР ПОД КЛЮЧ В МОСКВЕ И МО
        p.hero__text
          | Готовы превратить голые стены новостройки или старую вторичку в уютное жилье?
          | Закажите ремонт по вашему дизайн-проекту в нашей компании. Если проекта у Вас нет,
          | мы подберем для Вас проверенного дизайнера, а стоимость дизайн-проекта вычтем из стоимости ремонтных работ.

        .hero__bottom
          p.hero__note
            | ПРОСТО ПОЗВОНИТЕ ИЛИ НАПИШИТЕ НАМ, <br>
            | И МЫ НАЧНЕМ РАБОТУ НАД ВАШИМ ИДЕАЛЬНЫМ <br>
            | ПРОСТРАНСТВОМ!

          .hero__actions
            a.btn.btn--primary.hero__btn(href="#") Хочу проконсультироваться
            a.btn.btn--grey.hero__btn(href="#") Ознакомиться с услугами

      .hero__media
        .hero__slider.swiper(data-hero-swiper)
          .swiper-wrapper
            .swiper-slide.hero__slide
              img.hero__img(
                src="images/sovremennyi-i-elegantnyi-inter-er-gostinoi-s-abstraktnym-iskusstvom 1.jpg"
                alt="Интерьер гостиной"
                title="Интерьер гостиной"
                width="980"
                height="620"
                loading="lazy"
              )
            .swiper-slide.hero__slide
              img.hero__img(
                src="images/sovremennyi-i-elegantnyi-inter-er-gostinoi-s-abstraktnym-iskusstvom 1.jpg"
                alt="Интерьер кухни-гостиной"
                title="Интерьер кухни-гостиной"
                width="980"
                height="620"
                loading="lazy"
              )
            .swiper-slide.hero__slide
              img.hero__img(
                src="images/sovremennyi-i-elegantnyi-inter-er-gostinoi-s-abstraktnym-iskusstvom 1.jpg"
                alt="Интерьер"
                title="Интерьер"
                width="980"
                height="620"
                loading="lazy"
              )

          .hero__controls
            button.hero__arrow.hero__arrow--prev(type="button" aria-label="Предыдущий слайд" data-hero-prev)
              span(aria-hidden="true") 
                <svg width="22" height="20" viewBox="0 0 22 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M10 1L1 10L10 19M2.25 10L20.5 10" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            .hero__dots(data-hero-pagination)
            button.hero__arrow.hero__arrow--next(type="button" aria-label="Следующий слайд" data-hero-next)
              span(aria-hidden="true") 
                <svg width="22" height="20" viewBox="0 0 22 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M11.5 1L20.5 10L11.5 19M19.25 10L1 10" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>