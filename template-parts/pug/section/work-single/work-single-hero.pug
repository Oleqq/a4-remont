section.work-single-hero
	.work-single-hero__container._container
		.work-single-hero__top
			.work-single-hero__head
				h1.section__title.work-single-hero__title Ремонт квартиры в ЖК «Изумрудные холмы»
				p.section__subtitle.work-single-hero__lead
					| Объект сдан после капитальной перепланировки. Проведен демонтаж
					| старой отделки и объединены жилые зоны. Акцент на расширении
					| полезной площади и подготовке под комбинированную покраску.

			.work-single-hero__facts
				article.work-single-hero__fact
					p.work-single-hero__fact-label Локация:
					p.work-single-hero__fact-value бул. Космонавтов, 8

				article.work-single-hero__fact
					p.work-single-hero__fact-label Площадь квартиры:
					p.work-single-hero__fact-value 82 м²

				article.work-single-hero__fact
					p.work-single-hero__fact-label Срок выполнения работ:
					p.work-single-hero__fact-value 8 месяцев

				article.work-single-hero__fact
					p.work-single-hero__fact-label Стоимость ремонта:
					p.work-single-hero__fact-value 1 800 000₽

		.work-single-hero__bottom
			.work-single-hero__info
				h2.section__title.work-single-hero__info-title Общая информация о проекте
				.work-single-hero__text(data-work-single-text)
					p
						| ЖК «Изумрудные холмы» находится в Красногорске. Дом окружает лесной массив. Это дает району серьезное
						| преимущество. Инфраструктура внутри квартала полностью готова: работают школы, сады и магазины. Жильцам
						| квартир не нужно выезжать за пределы микрорайона за базовыми услугами. Дорога до Москвы занимает полчаса.
						| ЖК расположен в тихом месте с прямым выходом к прогулочным зонам.
					p
						| В ремонт зашла евротрешка с кухней-гостиной, спальней и детской в состоянии от застройщика. Требовалось
						| полностью убрать старые перегородки и отделку, чтобы переделать пространство под нужды семьи по авторскому проекту.
						| Главная инженерная сложность заключалась в правильном присоединении двух лоджий к жилой площади, что потребовало
						| серьезного утепления внешнего контура.
				button.work-single-hero__more(type="button" data-work-single-more) ...ещё

			figure.work-single-hero__media
				img.work-single-hero__image(
					src="images/sdvsdvsdsdsdvds.png"
					alt="Фото реализованного проекта"
					title="Фото реализованного проекта"
					width="950"
					height="770"
					loading="lazy"
				)
