section.news-latest
	.news-latest__container._container
		.news-latest__head
			.news-latest__info
				h2.section__title.news-latest__title Последние новости
				p.section__subtitle.news-latest__lead
					| Следите за обновлениями. На сайте мы делимся трендами в интерьере и
					| рассказываем, как сэкономить на ремонте квартиры не в ущерб качеству.
			a.btn.btn--grey.news-latest__btn.news-latest__btn--desktop(href="#") Больше новостей

		.news-latest__grid
			article.news-latest-card
				a.news-latest-card__link(href="#" aria-label="Открыть новость: Название новости")
					.news-latest-card__media
						img.news-latest-card__img(
							src="images/sovremennyi-i-elegantnyi-inter-er-gostinoi-s-abstraktnym-iskusstvom 1 (6).png"
							alt="Название новости"
							title="Название новости"
							width="420"
							height="360"
							loading="lazy"
						)
						.news-latest-card__tags
							span.news-latest-card__tag Ремонт
							span.news-latest-card__tag Дизайн интерьера
					.news-latest-card__bottom
						h3.news-latest-card__title Название новости<br> Название новости
						span.news-latest-card__more Смотреть

